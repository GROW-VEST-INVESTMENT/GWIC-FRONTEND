# Local backend configuration. Render supplies PORT automatically.
NODE_ENV=development
PORT=5000

# Required backend secrets and service URLs.
MONGODB_URI=
JWT_SECRET=
PAYSTACK_SECRET_KEY=
ADMIN_URL=http://localhost:5173
# Legacy name still supported: FRONTEND_URL
FRONTEND_URL=http://localhost:5173

# Optional. Use only if the frontend is hosted on additional origins.
CORS_ORIGINS=

# Required for the admin dashboard to log in with a real database-backed account.
# Quote the password if it contains special characters like # or $.
ADMIN_NAME="GWIC General Manager"
ADMIN_EMAIL="admin@gwic.com"
ADMIN_PASSWORD="StrongPassword!123"

# Keep disabled until the product is approved and operationally ready.
CORE_SAVINGS_ENABLED=false

# Optional staff-only review access.
ACCOUNT_REVIEW_TOKEN=

# Optional profile photo storage. Configure all three together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
