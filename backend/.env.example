# Local backend configuration. Render supplies PORT automatically.
NODE_ENV=development
PORT=5000

# Required backend secrets and service URLs.
MONGODB_URI=
JWT_SECRET=
PAYSTACK_SECRET_KEY=
ADMIN_URL=http://localhost:5173
# Legacy name still supported: FRONTEND_URL
FRONTEND_URL=http://localhost:5173

# Optional. Use only if the frontend is hosted on additional origins.
CORS_ORIGINS=

# Optional admin bootstrap. Set a unique email and strong password only in the
# deployment environment; never use a sample or shared credential.
ADMIN_NAME="Kalma Capital Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Keep disabled until the product is approved and operationally ready.
CORE_SAVINGS_ENABLED=false

# Optional staff-only review access.
ACCOUNT_REVIEW_TOKEN=

# Optional profile photo storage. Configure all three together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend email delivery. The onboarding sender is for restricted account tests;
# production email requires a verified sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kalma Capital <onboarding@resend.dev>
RESEND_TEST_TO=
RESEND_TEST_MODE=false
